<!--
  PHASE L3 - AtsEX LEGACY telemetry sender (the DATA plane of the HUD): reads the Legacy API and sends the telemetry contract (with AVAIL).
  PHASE PID-D4 / SLICE 1: where the telemetry goes depends on the mode. NORMAL mode (no Caller in this BVE process): the plain text to UDP 127.0.0.1:54321, unchanged.
  MANAGED mode (the Caller is active): an Envelope v1 to the loopback endpoint that the managed application publishes in the per-PID Telemetry Directory, and nothing else.
  The routing core is the verified Current sender core ..\..\..\TsScoringPlugin\CurrentDataPlane.cs, LINKED UNCHANGED (never copied, never edited here); it uses the shared
  DataPlaneProtocol.cs / TelemetryDirectoryReader.cs, which were already linked. PHASE PID-D4 / LEGACY JUMP 2A-ALPHA: the Current jump endpoint source ..\..\..\TsScoringPlugin\CurrentJumpEndpoint.cs is linked UNCHANGED, only to use JumpDirectoryPublisher, JumpCommandValidator, CurrentJumpCommand and JumpCapabilities.RequestId; the Legacy jump control plane (src\LegacyJumpEndpoint.cs, src\LegacyJumpCommandQueue.cs, src\LegacyJumpControlPlane.cs, host independent) never calls the Create method of that source and owns its own port, worker and Directory.
  It is still a separate extension from the Legacy Bridge (the CONTROL plane): no Handshake source is linked and no Current (BveEX) API type is referenced. The only named kernel
  objects it opens are the READ-ONLY control plane events Enabled / Ready and the AppDirectory / Telemetry Directory mappings of its own BVE process (managed mode only).
  The AtsEX legacy host assemblies are referenced read-only from the installed legacy host (Private=False: never copied or shipped, never in Git).
  No absolute user paths: the reference folder is built from the PUBLIC environment property.
  Source layout: src\LegacyTelemetryExtension.cs is the only file that names an AtsEx / BveTypes type; the rest is host independent; ..\Shared\ is the telemetry contract (shareable with a Current sender).
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A41D7E92-6B35-4C08-9F2E-5D18B3C7E604}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>TSScoringPlugin.Telemetry</RootNamespace>
    <AssemblyName>TSScoringPlugin.AtsExLegacy.Telemetry</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <OutputPath>out\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>none</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AtsExLegacyFolder>$(PUBLIC)\Documents\BveEx\Legacy\</AtsExLegacyFolder>
  </PropertyGroup>
  <!--
    PHASE PID-D4 / LEGACY JUMP LJX-1 (the minimal execution slice): the build flag. The DEFAULT build does not define LEGACY_JUMP_EXEC: the Legacy Jump execution is OFF (the
    Directory carries REQUEST_ID only, nothing is claimed or executed, the telemetry rows are the rows of the earlier build). Only the acceptance build is made with
    /p:LegacyJumpExec=true; it defines LEGACY_JUMP_EXEC and is the only build that may be deployed for the live acceptance of LJX-1.
  -->
  <PropertyGroup Condition="'$(LegacyJumpExec)' == 'true'">
    <DefineConstants>$(DefineConstants);LEGACY_JUMP_EXEC</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AtsEx.PluginHost">
      <HintPath>$(AtsExLegacyFolder)AtsEx.PluginHost.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BveTypes">
      <HintPath>$(AtsExLegacyFolder)BveTypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FastCaching">
      <HintPath>$(AtsExLegacyFolder)FastCaching.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FastMember">
      <HintPath>$(AtsExLegacyFolder)FastMember.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TypeWrapping">
      <HintPath>$(AtsExLegacyFolder)TypeWrapping.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\AssemblyInfo.cs" />
    <Compile Include="src\LegacyApi.cs" />
    <Compile Include="..\..\..\TsScoringPlugin\CurrentDataPlane.cs">
      <Link>Shared\CurrentDataPlane.cs</Link>
    </Compile>
    <Compile Include="..\..\..\TsScoringPlugin\CurrentJumpEndpoint.cs">
      <Link>Shared\CurrentJumpEndpoint.cs</Link>
    </Compile>
    <Compile Include="src\LegacyDataPlaneSink.cs" />
    <Compile Include="src\LegacyGroundLimits.cs" />
    <Compile Include="src\LegacyHandleContract.cs" />
    <Compile Include="..\Shared\GenericHandleTextContract.cs">
      <Link>Shared\GenericHandleTextContract.cs</Link>
    </Compile>
    <Compile Include="src\LegacyInputProbe.cs" />
    <Compile Include="..\Shared\DataPlaneProtocol.cs">
      <Link>Shared\DataPlaneProtocol.cs</Link>
    </Compile>
    <Compile Include="..\Shared\TelemetryDirectoryReader.cs">
      <Link>Shared\TelemetryDirectoryReader.cs</Link>
    </Compile>
    <Compile Include="src\LegacyInputTelemetry.cs" />
    <Compile Include="src\LegacyJumpCommandQueue.cs" />
    <Compile Include="src\LegacyJumpControlPlane.cs" />
    <Compile Include="src\LegacyJumpEndpoint.cs" />
    <Compile Include="src\LegacyJumpExecutor.cs" />
    <Compile Include="src\LegacyScoringProbe.cs" />
    <Compile Include="src\LegacyStationTimeline.cs" />
    <Compile Include="src\LegacyTelemetrySession.cs" />
    <Compile Include="src\LegacyTelemetryExtension.cs" />
    <Compile Include="..\Shared\TelemetryContract.cs">
      <Link>Shared\TelemetryContract.cs</Link>
    </Compile>
    <Compile Include="..\Shared\StationListIdentity.cs">
      <Link>Shared\StationListIdentity.cs</Link>
    </Compile>
    <Compile Include="..\Shared\JumpWire.cs">
      <Link>Shared\JumpWire.cs</Link>
    </Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
