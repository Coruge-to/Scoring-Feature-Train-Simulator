<?xml version="1.0" encoding="utf-8"?>
<!--
  PHASE C1 OBSERVATION BUILD - BveEX Bridge (minimal extension).
  The BveEX assemblies are referenced read-only from the installed BveEX (Private=False: never copied or shipped).
  No absolute user paths: the reference folder is built from the PUBLIC environment property.
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{9C3E7A10-5B28-4D71-A6F4-0E81D5B2C7A9}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>TSScoringPlugin.Handshake</RootNamespace>
    <AssemblyName>TSScoringPlugin.BveEx.Bridge.Prototype</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <OutputPath>out\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>none</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <BveExFolder>$(PUBLIC)\Documents\BveEx\2.0\</BveExFolder>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BveEx.PluginHost">
      <HintPath>$(BveExFolder)BveEx.PluginHost.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BveTypes">
      <HintPath>$(BveExFolder)BveTypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FastCaching">
      <HintPath>$(BveExFolder)FastCaching.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FastMember">
      <HintPath>$(BveExFolder)FastMember.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TypeWrapping">
      <HintPath>$(BveExFolder)TypeWrapping.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\AssemblyInfo.cs" />
    <Compile Include="src\TsScoringBridgePrototype.cs" />
    <Compile Include="src\ScenarioObserver.cs" />
    <Compile Include="..\Shared\HandshakeProtocol.cs">
      <Link>Shared\HandshakeProtocol.cs</Link>
    </Compile>
    <Compile Include="..\Shared\ObservationLog.cs">
      <Link>Shared\ObservationLog.cs</Link>
    </Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
