<?xml version="1.0" encoding="utf-8"?>
<!--
  PHASE E1 - input-device Caller (handshake, ScenarioReady reader + log, BveEX dependency notice at scenario use start, DrivingActive state, AppController dry-run).
  Mackoy.IInputDevice is referenced read-only from the installed BVE6 (identical to BVE5's copy), never copied or shipped.
  No absolute user paths: the reference path is built from the ProgramW6432 environment property.
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7B1C5D2E-3A64-4F08-8E7B-2D9A41C06F31}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>TSScoringPlugin.Handshake</RootNamespace>
    <AssemblyName>TSScoringPlugin.Caller.InputDevice</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <OutputPath>out\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
    <DefineConstants>TRACE;CALLER_DLL</DefineConstants>
    <ErrorReport>none</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mackoy.IInputDevice">
      <HintPath>$(ProgramW6432)\mackoy\BveTs6\Mackoy.IInputDevice.DLL</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\AppController.cs" />
    <Compile Include="src\AssemblyInfo.cs" />
    <Compile Include="src\DrivingActivityState.cs" />
    <Compile Include="src\HandshakeSession.cs" />
    <Compile Include="src\TsScoringCallerInputDevice.cs" />
    <Compile Include="..\Shared\AppProtocol.cs">
      <Link>Shared\AppProtocol.cs</Link>
    </Compile>
    <Compile Include="..\Shared\HandshakeProtocol.cs">
      <Link>Shared\HandshakeProtocol.cs</Link>
    </Compile>
    <Compile Include="..\Shared\ObservationLog.cs">
      <Link>Shared\ObservationLog.cs</Link>
    </Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
